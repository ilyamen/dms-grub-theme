#!/usr/bin/python3 -I
"""Render a GRUB theme from Material You colors and keep GRUB pointed at it.

    dms-grub-theme status                                  JSON for the plugin, no root needed
    dms-grub-theme apply --size WxH|auto [--fade] [--timeout-text T] [--hints-text T] ROLE=#RRGGBB...
    dms-grub-theme config --timeout N                      menu timeout, then update-grub
    dms-grub-theme fonts                                   build the fonts (run by install.sh)
    dms-grub-theme version

polkit lets the active session run this as root without a password, so the
desktop can repaint the menu after every wallpaper change. It accepts only
colors, a screen size, a timeout and two short labels, and writes only the
theme directory and its grub.d drop-in.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

VERSION = "1.0.0"
# Bumped whenever the theme comes out differently, so the plugin redraws it
RENDERER = 3
THEME_DIR = Path("/boot/grub/themes/dms")
CFG = Path("/etc/default/grub.d/90-dms-grub-theme.cfg")
# Fonts are built once at install time, next to the installed helper
DATA_DIR = Path(__file__).resolve().parent.parent / "share" / "dms-grub-theme"
INSTALLED = [Path("/usr/local/libexec/dms-grub-theme"), Path("/usr/libexec/dms-grub-theme")]
FONT_CANDIDATES = [
    "/usr/share/fonts/truetype/inter-vf/InterVariable.ttf",
    "/usr/share/fonts/opentype/inter/Inter-Regular.otf",
]
# Latin, Cyrillic, punctuation, arrows: enough for menu entries in most languages DMS ships
FONT_RANGES = "0x20-0x7E,0xA0-0x24F,0x370-0x3FF,0x400-0x4FF,0x2013-0x2026,0x2190-0x21FF"
# Text and entry font sizes for each screen height the layout is drawn for:
# GRUB fonts are bitmaps, so every height gets its own
TIERS = {1080: (24, 30), 1440: (32, 40), 2160: (48, 60)}
FONTS = sorted({(f"font-{size}.pf2", size, False) for pair in TIERS.values() for size in pair}
               | {(f"font-bold-{big}.pf2", big, True) for _, big in TIERS.values()})

ROLES = ["surface", "surface_container", "primary_container", "on_primary_container",
         "on_surface", "on_surface_variant", "outline"]
COLOR_RE = re.compile(r"^#[0-9a-fA-F]{6}$")
SIZE_RE = re.compile(r"^([1-9][0-9]{2,4})x([1-9][0-9]{2,4})$")
# GRUB's own "auto" falls back to 800x600 when the screen reports a native mode
# 4096 pixels wide or more, which ultrawide and 5K screens do. Auto asks for
# 1440p first, which nearly every firmware offers and wide screens show 1:1,
# then for the 1080p the firmware itself usually runs in.
AUTO_SIZE = (2560, 1440)
FALLBACK_MODES = ["2560x1440", "1920x1080", "auto"]

# Layout at 1080p, scaled for the others
ITEM_HEIGHT = 64
MENU_WIDTH = 820

os.environ["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"


def fail(message, code=1):
    print(f"dms-grub-theme: {message}", file=sys.stderr)
    sys.exit(code)


def hex_to_rgb(value):
    return tuple(int(value[i:i + 2], 16) for i in (1, 3, 5))


def label_text(value):
    """Labels end up in quotes in theme.txt: keep them on one line and quote-free."""
    return re.sub(r'["\\\n\r\t]', "", value)[:120]


# --- status -----------------------------------------------------------------

def read_cfg():
    if not CFG.exists():
        return None
    config = {}
    for line in CFG.read_text().splitlines():
        match = re.match(r"^(GRUB_[A-Z_]+)=(.*)$", line)
        if match:
            config[match.group(1)] = match.group(2).strip('"')
    try:
        timeout = int(config.get("GRUB_TIMEOUT", ""))
    except ValueError:
        timeout = None
    return {"timeout": timeout, "gfxmode": config.get("GRUB_GFXMODE", "")}


def status():
    installed = None
    for path in INSTALLED:
        if path.exists():
            out = subprocess.run([str(path), "version"], capture_output=True, text=True)
            # Run from the plugin, this also tells whether the installed copy is this one
            same = path.read_bytes() == Path(__file__).read_bytes()
            installed = {"path": str(path), "version": out.stdout.strip(), "current": same}
            break
    applied = None
    try:
        applied = json.loads((THEME_DIR / "palette.json").read_text())
    except (OSError, ValueError):
        pass
    try:
        import PIL  # noqa: F401
        pil = True
    except ImportError:
        pil = False
    print(json.dumps({
        "version": VERSION,
        "renderer": RENDERER,
        "installed": installed,
        "applied": applied,
        "config": read_cfg(),
        "grub": Path("/etc/grub.d").is_dir() and shutil.which("update-grub") is not None,
        "pil": pil,
        "mkfont": shutil.which("grub-mkfont") is not None,
        "font": next((f for f in FONT_CANDIDATES if Path(f).exists()), None),
    }))


# --- rendering ----------------------------------------------------------------

def side_mask(width, height):
    """White in the middle, easing to black over the outer part of the left and right sides."""
    from PIL import Image
    edge = width * 0.18
    values = []
    for i in range(width):
        t = max(0.0, min(1.0, min(i, width - 1 - i) / edge))
        values.append(round(255 * t * t * (3 - 2 * t)))  # smoothstep
    row = Image.new("L", (width, 1))
    row.putdata(values)
    return row.resize((width, height), Image.NEAREST)


def background(c, width, height, fade):
    """The surface color with a soft glow of the primary container behind the menu.

    With fade, the sides ease into pure black: a firmware that can't drive a wide
    screen at its full size shows the menu in a box with black bars beside it,
    and the picture then melts into them instead of ending at a hard edge.
    """
    from PIL import Image, ImageDraw, ImageFilter
    base = Image.new("RGB", (width, height), hex_to_rgb(c["surface"]))
    glow = Image.new("RGB", (width, height), hex_to_rgb(c["surface"]))
    rx, ry = width * 0.42, height * 0.38
    cx, cy = width / 2, height * 0.55
    ImageDraw.Draw(glow).ellipse((cx - rx, cy - ry, cx + rx, cy + ry), fill=hex_to_rgb(c["primary_container"]))
    glow = glow.filter(ImageFilter.GaussianBlur(width / 9))
    image = Image.blend(base, glow, 0.45)
    if fade:
        image = Image.composite(image, Image.new("RGB", (width, height), (0, 0, 0)), side_mask(width, height))
    return image


def pill(color, height):
    """Left cap, 1-pixel center and right cap of a fully rounded highlight."""
    from PIL import Image, ImageDraw
    scale = 4  # draw large and scale down for smooth edges
    radius = height // 2
    big = Image.new("RGBA", (height * scale, height * scale), (0, 0, 0, 0))
    ImageDraw.Draw(big).ellipse((0, 0, height * scale - 1, height * scale - 1), fill=hex_to_rgb(color) + (255,))
    circle = big.resize((height, height), Image.LANCZOS)
    center = Image.new("RGBA", (1, height), hex_to_rgb(color) + (255,))
    return circle.crop((0, 0, radius, height)), center, circle.crop((radius, 0, height, height))


THEME = """\
# Written by dms-grub-theme from the DankMaterialShell palette; it is rewritten
# whenever the palette changes.
title-text: ""
desktop-image: "background.png"
desktop-image-scale-method: "stretch"
desktop-color: "{desktop_color}"
terminal-font: "DMS Regular {small}"
terminal-box: "terminal_*.png"

+ label {{
    top = 30%-{host_offset}
    left = 0
    width = 100%
    height = {host_height}
    align = "center"
    text = "{host}"
    font = "DMS Regular {small}"
    color = "{on_surface_variant}"
}}

+ boot_menu {{
    left = 50%-{half_width}
    top = 30%
    width = {menu_width}
    height = 50%
    item_font = "DMS Regular {big}"
    selected_item_font = "DMS Bold {big}"
    item_color = "{on_surface}"
    selected_item_color = "{on_primary_container}"
    item_height = {item_height}
    item_padding = {item_padding}
    item_spacing = {item_spacing}
    icon_width = 0
    icon_height = 0
    item_icon_space = 0
    selected_item_pixmap_style = "select_*.png"
    scrollbar = false
}}

+ label {{
    id = "__timeout__"
    top = 82%
    left = 0
    width = 100%
    height = {label_height}
    align = "center"
    text = "{timeout_text}"
    font = "DMS Regular {small}"
    color = "{on_surface_variant}"
}}

+ label {{
    top = 100%-{host_offset}
    left = 0
    width = 100%
    height = {label_height}
    align = "center"
    text = "{hints_text}"
    font = "DMS Regular {small}"
    color = "{outline}"
}}
"""


def write_cfg(timeout, gfxmode):
    CFG.parent.mkdir(parents=True, exist_ok=True)
    CFG.write_text(
        "# Written by dms-grub-theme (DankMaterialShell plugin GRUB Theme)\n"
        "GRUB_TIMEOUT_STYLE=menu\n"
        f"GRUB_TIMEOUT={timeout}\n"
        "# Ubuntu waits on the menu after a boot it considers failed, resume from hibernation included\n"
        f"GRUB_RECORDFAIL_TIMEOUT={timeout}\n"
        f"GRUB_GFXMODE={gfxmode}\n"
        "GRUB_GFXPAYLOAD_LINUX=keep\n"
        f"GRUB_THEME={THEME_DIR}/theme.txt\n")


def gfxmode(size):
    """The mode asked for, then fallbacks: GRUB takes the first the firmware has."""
    modes = [] if size == "auto" else [size]
    return ",".join(modes + [mode for mode in FALLBACK_MODES if mode not in modes])


def layout(height):
    """Pixel sizes for the nearest height there are fonts for."""
    tier = min(TIERS, key=lambda t: abs(t - height))
    small, big = TIERS[tier]
    scale = tier / 1080
    return {"small": small, "big": big, "item_height": round(ITEM_HEIGHT * scale),
            "menu_width": round(MENU_WIDTH * scale), "item_padding": round(28 * scale),
            "item_spacing": round(10 * scale), "host_offset": round(72 * scale),
            "host_height": round(48 * scale), "label_height": round(40 * scale)}


def update_grub():
    result = subprocess.run(["update-grub"], capture_output=True, text=True)
    if result.returncode != 0:
        fail("update-grub failed: " + (result.stderr.strip().splitlines() or ["?"])[-1])


def apply(args):
    from PIL import Image
    colors = {}
    for item in args.colors:
        role, _, value = item.partition("=")
        if role not in ROLES or not COLOR_RE.match(value):
            fail(f"bad color {item!r}", 2)
        colors[role] = value.lower()
    missing = [role for role in ROLES if role not in colors]
    if missing:
        fail("missing colors: " + ", ".join(missing), 2)
    if args.size == "auto":
        width, height = AUTO_SIZE
    else:
        size = SIZE_RE.match(args.size)
        if not size:
            fail(f"bad size {args.size!r}", 2)
        width, height = int(size.group(1)), int(size.group(2))
    sizes = layout(height)
    fonts = [DATA_DIR / name for name, size, _ in FONTS if size in (sizes["small"], sizes["big"])]
    if not all(f.exists() for f in fonts):
        fail("fonts are missing, reinstall the helper")

    # Build next to the theme and swap it in, so GRUB never sees half a theme
    THEME_DIR.parent.mkdir(parents=True, exist_ok=True)
    staging = Path(tempfile.mkdtemp(prefix=".dms-new-", dir=THEME_DIR.parent))
    try:
        background(colors, width, height, args.fade).save(staging / "background.png", optimize=True)
        for part, image in zip("wce", pill(colors["primary_container"], sizes["item_height"])):
            image.save(staging / f"select_{part}.png")
        Image.new("RGB", (1, 1), hex_to_rgb(colors["surface_container"])).save(staging / "terminal_c.png")
        for font in fonts:
            shutil.copy(font, staging / font.name)
        (staging / "theme.txt").write_text(THEME.format(
            host=label_text(os.uname().nodename), half_width=sizes["menu_width"] // 2,
            desktop_color="#000000" if args.fade else colors["surface"], timeout_text=label_text(args.timeout_text),
            hints_text=label_text(args.hints_text), **sizes, **colors))
        (staging / "palette.json").write_text(json.dumps({
            "colors": colors, "size": args.size, "fade": args.fade, "timeoutText": label_text(args.timeout_text),
            "hintsText": label_text(args.hints_text), "renderer": RENDERER, "time": int(time.time())}))
        for path in staging.iterdir():
            path.chmod(0o644)
        staging.chmod(0o755)
        old = None
        if THEME_DIR.exists():
            old = THEME_DIR.with_name(".dms-old")
            shutil.rmtree(old, ignore_errors=True)
            THEME_DIR.rename(old)
        staging.rename(THEME_DIR)
        if old:
            shutil.rmtree(old, ignore_errors=True)
    finally:
        shutil.rmtree(staging, ignore_errors=True)

    # A new screen size or the first theme also need grub.cfg regenerated
    config = read_cfg()
    if config is None or config["gfxmode"] != gfxmode(args.size):
        write_cfg(config["timeout"] if config and config["timeout"] is not None else 3, gfxmode(args.size))
        update_grub()


def config(args):
    if not 0 <= args.timeout <= 30:
        fail("timeout must be 0-30 seconds", 2)
    current = read_cfg()
    write_cfg(args.timeout, current["gfxmode"] if current and current["gfxmode"] else gfxmode("auto"))
    update_grub()


def fonts(_args):
    source = next((f for f in FONT_CANDIDATES if Path(f).exists()), None)
    if not source:
        match = subprocess.run(["fc-match", "-f", "%{file}", "sans-serif"], capture_output=True, text=True)
        source = match.stdout.strip() or fail("no font found")
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    for name, size, bold in FONTS:
        command = ["grub-mkfont", "-s", str(size), "-n", "DMS", "-r", FONT_RANGES, "-o", str(DATA_DIR / name)]
        if bold:
            command.insert(1, "-b")
        # Variable fonts make grub-mkfont warn about every axis table it skips
        subprocess.run(command + [source], check=True, stderr=subprocess.DEVNULL)


def main():
    parser = argparse.ArgumentParser(prog="dms-grub-theme")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("status")
    commands.add_parser("version")
    commands.add_parser("fonts")
    p = commands.add_parser("apply")
    p.add_argument("--size", required=True)
    p.add_argument("--fade", action="store_true")
    p.add_argument("--timeout-text", default="Booting in %d s")
    p.add_argument("--hints-text", default="↑ ↓  select    ·    Enter  boot    ·    E  edit    ·    C  console")
    p.add_argument("colors", nargs="+")
    p = commands.add_parser("config")
    p.add_argument("--timeout", type=int, required=True)
    args = parser.parse_args()

    if args.command == "status":
        status()
    elif args.command == "version":
        print(VERSION)
    elif os.geteuid() != 0:
        fail(f"{args.command} needs root", 2)
    else:
        {"apply": apply, "config": config, "fonts": fonts}[args.command](args)


if __name__ == "__main__":
    main()
