<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>dms-grub-theme</vendor>
  <vendor_url>https://github.com/ilyamen/dms-grub-theme</vendor_url>
  <!-- The active session repaints the menu after every wallpaper change -->
  <action id="io.github.ilyamen.dms-grub-theme.apply">
    <description>Update the GRUB theme</description>
    <description xml:lang="ru">Обновить тему GRUB</description>
    <message>Authentication is required to update the GRUB theme</message>
    <message xml:lang="ru">Для обновления темы GRUB требуется аутентификация</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXECDIR@/dms-grub-theme</annotate>
  </action>
</policyconfig>
